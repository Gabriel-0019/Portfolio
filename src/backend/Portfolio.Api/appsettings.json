{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Portfolio": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "RateLimiting": {
    "Contact": {
      "PermitLimit": 5,
      "WindowMinutes": 10
    },
    "Login": {
      "PermitLimit": 10,
      "WindowMinutes": 5
    }
  },
  "Admin": {
    "Email": "",
    "Password": ""
  },
  "Storage": {
    "RootPath": "",
    "RequestPath": "/uploads",
    "MaxBytes": 10485760
  }
}
